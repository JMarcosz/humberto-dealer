# ==============================================================================
# HUMBERTO DEALER — Variables de entorno para Docker Compose
# ==============================================================================
# Copia este archivo como .env en la raíz del proyecto antes de ejecutar:
# cp .env.docker.example .env
# ==============================================================================

# ── Base de Datos MySQL ───────────────────────────────────────────────────────
MYSQL_DATABASE=concesionaria
MYSQL_USER=dealer_user
MYSQL_PASSWORD=dealer_secure_password_123
MYSQL_ROOT_PASSWORD=dealer_root_password_456
DB_PORT=3306

# ── Backend Flask ─────────────────────────────────────────────────────────────
FLASK_ENV=production
FLASK_DEBUG=0
# Genera una clave aleatoria en consola con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar_por_clave_secreta_super_segura_32_bytes_minimo
FRONTEND_URL=http://localhost:3000

# ── Frontend Next.js ──────────────────────────────────────────────────────────
# Puerto expuesto en el host del servidor
FRONTEND_PORT=3000
BACKEND_PORT=5001
# Ruta relativa usada por el cliente en el navegador
NEXT_PUBLIC_API_URL=/api
# URL de red interna de Docker usada por SSR y rewrites del contenedor frontend
BACKEND_URL=http://backend:5001/api

# ── Información de Contacto / Frontend (Opcional) ─────────────────────────────
NEXT_PUBLIC_PHONE_NUMBER=8095551234
NEXT_PUBLIC_PHONE_FORMATTED=(809) 555-1234
NEXT_PUBLIC_CONTACT_EMAIL=info@humbertodealer.com
NEXT_PUBLIC_BUSINESS_ADDRESS=Av. 27 de Febrero, Santo Domingo, D.N.

# ── WhatsApp Business API (Opcional - dejar vacío si no se usa) ───────────────
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_OWNER_NUMBER=

# ── Google OAuth 2.0 (Opcional - dejar vacío si no se usa) ────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
